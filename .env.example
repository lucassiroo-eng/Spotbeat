# ── Backend (Railway env vars) ────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=                          # from Spotify dashboard
SPOTIFY_CLIENT_SECRET=                      # from Spotify dashboard (unused by PKCE but kept for safety)
SPOTIFY_REDIRECT_URI=https://your-web.vercel.app/callback   # set after Vercel deploy
DATABASE_URL=sqlite:/data/prod.db           # /data is the Railway volume mount
ADMIN_PASSWORD=change-me-to-something-strong
PORT=3000
WEB_URL=https://your-web.vercel.app         # set after Vercel deploy
NODE_ENV=production

# ── Frontend (Vercel env vars) ────────────────────────────────────────────────
VITE_SPOTIFY_CLIENT_ID=                     # same Client ID as above
VITE_API_URL=https://your-api.railway.app   # set after Railway deploy

# ── Local development ─────────────────────────────────────────────────────────
# Copy this file to .env (backend) and apps/web/.env (frontend) and fill in:
#   SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
#   WEB_URL=http://127.0.0.1:5173
#   DATABASE_URL=sqlite:./dev.db
#   VITE_API_URL=http://127.0.0.1:3000
